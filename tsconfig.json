{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./*"] },
    "types": ["vite/client"]
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "vite.config.mts"]
}


